          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données Open-Meteo — modèle agricole : humidité et température du sol, ET0 FAO-56, déficit de pression de vapeur. Parcelle à %1$@."
          }
        }

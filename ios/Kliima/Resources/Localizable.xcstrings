{
  "sourceLanguage": "fr",
  "strings": {
    "account.active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tier opened by this account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan Pro abierto por esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Palier Pro ouvert par ce compte."
          }
        }
      }
    },
    "account.error.apple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple did not open the sign-in (code %1$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no abrió el inicio de sesión (código %1$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'a pas ouvert la connexion (code %1$@)."
          }
        }
      }
    },
    "account.error.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts are not open on the server yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas aún no están abiertas en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes ne sont pas encore ouverts sur le serveur."
          }
        }
      }
    },
    "account.error.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not accept Apple's proof. Try again; if it persists, report it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no reconoció la prueba de Apple. Inténtelo de nuevo; si persiste, avíselo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas reconnu la preuve d'Apple. Réessayez ; si cela persiste, signalez-le."
          }
        }
      }
    },
    "account.error.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server unreachable for now. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidor inaccesible por ahora. Inténtelo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur injoignable pour l'instant. Réessayez plus tard."
          }
        }
      }
    },
    "account.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple: if your account is invited, the tier opens without going through the store. Nothing to type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión con Apple: si su cuenta está invitada, el plan se abre sin pasar por la tienda. Nada que escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Apple : si votre compte est invité, le palier s'ouvre sans passer par la boutique. Rien à saisir."
          }
        }
      }
    },
    "account.notInvited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is not invited yet: the address above is the one to add to the list. To make Apple give a different one, signing out is not enough — it keeps the choice made at the first sign-in. Go to Settings › your name › Sign in with Apple › Kliima ‣ › Stop Using, then sign in again and choose “Share My Email”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta aún no está invitada: la dirección de arriba es la que hay que añadir a la lista. Para que Apple dé otra, cerrar sesión no basta: conserva la elección hecha al primer inicio. Vaya a Ajustes › su nombre › Iniciar sesión con Apple › Kliima ‣ › Dejar de usar, y vuelva a iniciar sesión eligiendo «Compartir mi correo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'est pas encore invité : c'est l'adresse ci-dessus qu'il faut ajouter à la liste. Pour qu'Apple en donne une autre, se déconnecter ne suffit pas — il garde le choix fait à la première connexion. Passez par Réglages › votre nom › Se connecter avec Apple › Kliima ‣ › Ne plus utiliser, puis reconnectez-vous en choisissant « Partager mon adresse e-mail »."
          }
        }
      }
    },
